diff --git a/dlls/ntdll/signal_arm64ec.c b/dlls/ntdll/signal_arm64ec.c
index 6fe78c5..2cf5a07 100644
--- a/dlls/ntdll/signal_arm64ec.c
+++ b/dlls/ntdll/signal_arm64ec.c
@@ -138,7 +138,8 @@ static void load_x64_debug_regs( CONTEXT *context )
     context->Dr1 = regs->dr1;
     context->Dr2 = regs->dr2;
     context->Dr3 = regs->dr3;
-    context->Dr6 = regs->dr6;
+    /* Windows 10 reports Dr6 with its reserved bits set (ffff0ff0) while Dr7 arms a breakpoint. */
+    context->Dr6 = regs->dr7 ? regs->dr6 | 0xffff0ff0 : regs->dr6;
     context->Dr7 = regs->dr7;
 }
 
@@ -3524,8 +3525,38 @@ NTSTATUS call_seh_handlers( EXCEPTION_RECORD *rec, CONTEXT *orig_context )
                 }
                 ios_seh_xlate_note( dispatch.LanguageHandler, handler, is_ec );
 
-                res = call_seh_handler( rec, dispatch.EstablisherFrame, orig_context,
-                                        &dispatch, handler );
+                /* iOS-Madeira: WHAT AN X64 FRAME HANDLER DID WITH ITS CONTEXT AND WHAT IT RETURNED.
+                 * Seamless Co-op's ersc.dll (Themida) gets its trap-flag SINGLE_STEP in its frame
+                 * handler (ersc.dll+0x31eed6), then returns something that is no disposition: the
+                 * STATUS_INVALID_DISPOSITION it raises goes back to the same handler until the
+                 * stack overflows (build 78, 2026-10-20 21:29). The first 64 guest handler calls
+                 * log the return and the context before/after; every invalid return is logged. */
+                if (!is_ec)
+                {
+                    static LONG guest_n, bad_n;
+                    const CONTEXT *c = orig_context;
+                    DWORD64 rip = c->Rip, rsp = c->Rsp, dr7 = c->Dr7;
+                    DWORD efl = c->EFlags, cflags = c->ContextFlags;
+                    LONG n;
+
+                    res = call_seh_handler( rec, dispatch.EstablisherFrame, orig_context,
+                                            &dispatch, handler );
+                    n = InterlockedIncrement( &guest_n );
+                    if (n <= 64 || (res > ExceptionCollidedUnwind && InterlockedIncrement( &bad_n ) <= 16))
+                        ERR( "[guest-seh] #%d handler=%p code=%08x addr=%p flags=%x frame=%p -> res=%#x | "
+                             "before rip=%p rsp=%p efl=%08x dr7=%llx cf=%08x | after rip=%p rsp=%p efl=%08x "
+                             "dr0-3=%llx/%llx/%llx/%llx dr6=%llx dr7=%llx cf=%08x\n",
+                             (int)n, dispatch.LanguageHandler, (UINT)rec->ExceptionCode, rec->ExceptionAddress,
+                             (UINT)rec->ExceptionFlags, (void *)dispatch.EstablisherFrame, (UINT)res,
+                             (void *)rip, (void *)rsp, (UINT)efl, (unsigned long long)dr7, (UINT)cflags,
+                             (void *)c->Rip, (void *)c->Rsp, (UINT)c->EFlags,
+                             (unsigned long long)c->Dr0, (unsigned long long)c->Dr1,
+                             (unsigned long long)c->Dr2, (unsigned long long)c->Dr3,
+                             (unsigned long long)c->Dr6, (unsigned long long)c->Dr7, (UINT)c->ContextFlags );
+                }
+                else
+                    res = call_seh_handler( rec, dispatch.EstablisherFrame, orig_context,
+                                            &dispatch, handler );
             }
             rec->ExceptionFlags &= EXCEPTION_NONCONTINUABLE;
             TRACE( "handler at %p returned %lu\n", dispatch.LanguageHandler, res );
