+/* iOS-Madeira: THE X64 DEBUG REGISTERS A GUEST SETS THROUGH A CONTEXT.
+ *
+ * An ARM64EC context has no room for Dr0-3/Dr6/Dr7: context_x64_to_arm() drops them
+ * and context_arm_to_x64() zeroes them, and no context carried
+ * CONTEXT_AMD64_DEBUG_REGISTERS. So a copy protection's exception handler (Seamless
+ * Co-op's ersc.dll, Themida) that writes Dr0-3/Dr7 into its context found them gone at
+ * the next exception, and saw ContextFlags 0010000b where Windows gives 0010005f
+ * (tests/x64/tfstep-x64.c "drrt").
+ *
+ * They are kept per thread behind TEB->BStoreLimit (IA64 only, unused on 64-bit), set
+ * by NtContinue/NtContinueEx and NtSetContextThread on the current thread, and given
+ * back in every exception context and by NtGetContextThread on the current thread.
+ * As measured on Windows 10: Dr0-3 read back as 0 while Dr7 enables none of them, and
+ * an armed Dr7 reads back with bit 10 set. They are only stored: no hardware
+ * breakpoint fires. */
+struct x64_debug_regs { DWORD64 dr0, dr1, dr2, dr3, dr6, dr7; };
+
+static struct x64_debug_regs *get_x64_debug_regs( BOOL create )
+{
+    struct x64_debug_regs *regs = NtCurrentTeb()->BStoreLimit;
+
+    if (!regs && create)
+    {
+        regs = RtlAllocateHeap( NtCurrentTeb()->Peb->ProcessHeap, HEAP_ZERO_MEMORY, sizeof(*regs) );
+        NtCurrentTeb()->BStoreLimit = regs;
+    }
+    return regs;
+}
+
+static void save_x64_debug_regs( const CONTEXT *context )
+{
+    struct x64_debug_regs *regs;
+    DWORD64 dr7 = context->Dr7;
+
+    if ((context->ContextFlags & CONTEXT_AMD64_DEBUG_REGISTERS) != CONTEXT_AMD64_DEBUG_REGISTERS) return;
+    if (!(regs = get_x64_debug_regs( dr7 != 0 ))) return;
+    if (dr7 & 0xff)
+    {
+        regs->dr0 = context->Dr0;
+        regs->dr1 = context->Dr1;
+        regs->dr2 = context->Dr2;
+        regs->dr3 = context->Dr3;
+    }
+    else regs->dr0 = regs->dr1 = regs->dr2 = regs->dr3 = 0;
+    regs->dr6 = context->Dr6;
+    regs->dr7 = dr7 ? dr7 | 0x400 : 0;
+}
+
+/* For a context context_arm_to_x64() just built (Dr0-7 zero): also the segment
+ * registers it fills in, as Windows marks them. */
+static void load_x64_debug_regs( CONTEXT *context )
+{
+    const struct x64_debug_regs *regs = get_x64_debug_regs( FALSE );
+
+    context->ContextFlags |= CONTEXT_AMD64_SEGMENTS | CONTEXT_AMD64_DEBUG_REGISTERS;
+    if (!regs) return;
+    context->Dr0 = regs->dr0;
+    context->Dr1 = regs->dr1;
+    context->Dr2 = regs->dr2;
+    context->Dr3 = regs->dr3;
+    context->Dr6 = regs->dr6;
+    context->Dr7 = regs->dr7;
+}
