+// Drops the entries of handlers that are no longer running: those below Rsp on the guest stack, and with
+// Inclusive, one at Rsp itself.
+static void DropGuestExceptionEFlags(FrontendThreadData* Data, uint64_t Rsp, bool Inclusive) {
+  auto& Count = Data->ExceptionEFlagsCount;
+  while (Count && (Data->ExceptionEFlags[Count - 1].Rsp < Rsp || (Inclusive && Data->ExceptionEFlags[Count - 1].Rsp == Rsp))) {
+    Count--;
+  }
+}
+
+static void PushGuestExceptionEFlags(FEXCore::Core::InternalThreadState* Thread, uint64_t Rsp, uint64_t Rip, uint32_t EFlags) {
+  auto* Data = GetFrontendThreadData(Thread);
+  if (!Data) {
+    return;
+  }
+  DropGuestExceptionEFlags(Data, Rsp, true);
+  if (Data->ExceptionEFlagsCount < FrontendThreadData::MaxGuestExceptionEFlags) {
+    Data->ExceptionEFlags[Data->ExceptionEFlagsCount++] = {.Rsp = Rsp, .Rip = Rip, .EFlags = EFlags & GuestOnlyEFlagsMask};
+  }
+}
