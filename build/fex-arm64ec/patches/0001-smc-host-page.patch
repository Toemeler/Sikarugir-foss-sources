 bool InvalidationTracker::ProtectRWXIntervalsInternal(uint64_t Address, uint64_t Size, bool ForWriteLocked) {
+#ifdef FEX_IOS_HOST
+  if (IosHostPageSMC()) {
+    // smc-host-page: trap and untrap whole host pages. A trap of only the compiled 4 KB is
+    // undone by a writable sibling (Wine applies the union), an untrap of 4 KB opens all 16.
+    const uint64_t HostEnd = IosHostPageEnd(Address + Size);
+    Address = IosHostPageBase(Address);
+    Size = HostEnd - Address;
