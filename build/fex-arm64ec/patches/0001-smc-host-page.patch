+#ifdef FEX_IOS_HOST
+/* MADEIRA smc-host-page: SMC TRAPS ARE ONLY AS FINE AS THE HOST PAGE.
+ *
+ * This class tracks code in FEX_PAGE_SIZE (4 KB) pages, as on Windows. The iOS host pages
+ * are 16 KB, and Wine gives each host page the UNION of its four 4 KB protections
+ * (get_host_page_vprot / mprotect_range). That breaks the trap protocol both ways:
+ *
+ *   untrap: a write fault on 4 KB page A invalidated A only, then made A writable -- and
+ *           with it the whole host page, so compiled code on its three siblings could be
+ *           overwritten with no fault and kept running stale;
+ *   trap:   compiling code on page B asked for B read-only, but a sibling still writable in
+ *           Wine's table kept the host page writable, so B was never trapped at all.
+ *
+ * A self-decrypting image (Themida: Seamless Co-op's ersc.dll, sections EXECUTE|WRITE)
+ * hits both on its first unpack and runs translations of the encrypted bytes. So on iOS
+ * the trap state is kept per host page: a trap covers every RWX piece of the host page, a
+ * write fault invalidates and untraps the whole host page, and a protection change that
+ * makes any part of a host page writable invalidates the whole host page.
+ *
+ * Opt-in, MADEIRA_SMC_HOST_PAGE=1 (a game's own settings): a host-page fault invalidates four
+ * times the code, a cost games without such images (Mono's code lives in pool aliases, whose
+ * guest pages are never made writable) should not pay. Unset or anything else: 4 KB, as before. */
+static constexpr uint64_t IosHostPageSize = 0x4000;
+
+// Latched by HandleImageMap (getenv is not safe in FEX's early init, where the constructor
+// already walks memory through HandleMemoryProtectionNotification). Nothing is compiled
+// before the first image map, so the 4 KB mode it reads until then traps nothing.
+static std::atomic<bool> IosHostPageSMCOn {false};
+
+static bool IosHostPageSMC() {
+  return IosHostPageSMCOn.load(std::memory_order_relaxed);
+}
+
+static void IosHostPageSMCLatch() {
+  static std::atomic<bool> Latched {false};
+  if (Latched.exchange(true, std::memory_order_relaxed)) {
+    return;
+  }
+  const char* Env = getenv("MADEIRA_SMC_HOST_PAGE");
+  const bool On = Env && Env[0] == '1' && !Env[1];
+  IosHostPageSMCOn.store(On, std::memory_order_relaxed);
+  LogMan::Msg::EFmt("[smc-host-page] SMC traps per {} (MADEIRA_SMC_HOST_PAGE={})", On ? "16 KB host page" : "4 KB FEX page",
+                    Env ? Env : "unset");
+}
+
+static uint64_t IosHostPageBase(uint64_t Address) {
+  return Address & ~(IosHostPageSize - 1);
+}
+
+static uint64_t IosHostPageEnd(uint64_t End) {
+  return End > std::numeric_limits<uint64_t>::max() - (IosHostPageSize - 1) ? std::numeric_limits<uint64_t>::max() :
+                                                                               (End + IosHostPageSize - 1) & ~(IosHostPageSize - 1);
+}
+#endif
