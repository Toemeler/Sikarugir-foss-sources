+static GuestX87State CaptureGuestX87State(FEXCore::Core::InternalThreadState* Thread) {
+  const auto& State = Thread->CurrentFrame->State;
+  GuestX87State X87 {
+    .FCW = State.FCW,
+    .FSW = static_cast<uint16_t>(
+      (State.flags[FEXCore::X86State::X87FLAG_TOP_LOC] << 11) | (State.flags[FEXCore::X86State::X87FLAG_C0_LOC] << 8) |
+      (State.flags[FEXCore::X86State::X87FLAG_C1_LOC] << 9) | (State.flags[FEXCore::X86State::X87FLAG_C2_LOC] << 10) |
+      (State.flags[FEXCore::X86State::X87FLAG_C3_LOC] << 14) | State.flags[FEXCore::X86State::X87FLAG_IE_LOC]),
+    .AbridgedFTW = State.AbridgedFTW,
+  };
+  memcpy(X87.MM, State.mm, sizeof(X87.MM));
+  return X87;
+}
+
+static void StoreGuestX87State(const GuestX87State& X87, CONTEXT& Context) {
+  memcpy(Context.FltSave.FloatRegisters, X87.MM, sizeof(X87.MM));
+  Context.FltSave.ControlWord = X87.FCW;
+  Context.FltSave.StatusWord = X87.FSW;
+  Context.FltSave.TagWord = X87.AbridgedFTW;
+}
